PORT=5000
NODE_ENV=development

# PostgreSQL — use a free managed Postgres (Neon recommended) and paste its connection string.
# On Windows, double-check this file is saved as ".env" and not ".env.txt" —
# Explorer hides known extensions by default; use `dir /a` in a terminal to confirm.
# On Neon specifically, click "Show password" before copying — the string is masked by default.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Email (OTP verification + password reset) — any free SMTP works, e.g.:
#   Gmail: smtp.gmail.com, port 587, SMTP_SECURE=false, use a Google "App Password" (not your real password)
#   Brevo (formerly Sendinblue) free tier: smtp-relay.brevo.com, port 587, 300 emails/day free
#   Resend, Mailtrap (great for local testing without sending real email)
# Leave SMTP_HOST empty in local dev — OTP codes are logged to the console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ParkSlot <no-reply@yourdomain.com>

# Payments — CURRENTLY UNUSED.
# Payments are a fully mocked escrow simulation; no real gateway calls are made.
# These are placeholders for a future real payment integration (e.g. Razorpay or Stripe).
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=your_key_id
PAYMENT_KEY_SECRET=your_key_secret

# Platform
PLATFORM_COMMISSION_PERCENT=15

# CORS — comma-separated list of allowed frontend origins, or * for development
CORS_ORIGIN=http://localhost:5173
