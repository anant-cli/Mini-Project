PORT=5000
NODE_ENV=development

# PostgreSQL
# --- Option A (recommended: no local server) ---
# Use a free managed Postgres (Neon, Supabase, Railway, Render) and paste
# its connection string here. SSL is enabled automatically when this is set.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Option B (local Postgres install) ---
# Only used if DATABASE_URL above is left blank.
PGHOST=localhost
PGPORT=5432
PGDATABASE=parkslot
PGUSER=postgres
PGPASSWORD=postgres

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Payments (Razorpay/Stripe test keys)
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=your_key_id
PAYMENT_KEY_SECRET=your_key_secret

# Platform
PLATFORM_COMMISSION_PERCENT=15
CORS_ORIGIN=http://localhost:5173
