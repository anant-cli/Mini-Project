{
  "name": "parkslot-backend",
  "version": "1.0.0",
  "description": "ParkSlot API — auth, listings, bookings, escrow payments, EV charging, real-time slot updates",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "psql -d $PGDATABASE -f ../database/schema.sql",
    "build": "vite build"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
